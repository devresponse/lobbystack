# syntax=docker/dockerfile:1.7
# The control panel (docs/features/control-panel.md): a small Next.js app that
# reads the database as lobbystack_control, behind Cloudflare Access. It is
# built like the admin, from the same lockfile, but installs only its own
# dependencies.
FROM node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe AS build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm install --global pnpm@12.15.0
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY .github/build/prepare-image-workspace.mjs .github/build/prepare-image-workspace.mjs
RUN node .github/build/prepare-image-workspace.mjs --lockfile-only
RUN pnpm fetch --frozen-lockfile
COPY . .
RUN node .github/build/prepare-image-workspace.mjs
RUN pnpm install --offline --frozen-lockfile --filter "@lobbystack/control..."
RUN pnpm --filter @lobbystack/control build
RUN mkdir -p /prod && cp -R /app/apps/control/.next/static /prod/control-static && \
    find /prod/control-static -type f -name '*.map' -delete
RUN swc_helpers_path="$(find /app/node_modules/.pnpm -type d -path '*/node_modules/@swc/helpers' -print -quit)" && \
    test -n "$swc_helpers_path" && \
    standalone_path="/app/apps/control/.next/standalone/${swc_helpers_path#/app/}" && \
    mkdir -p "$standalone_path" && \
    cp -R "$swc_helpers_path/." "$standalone_path/"
RUN find /app/apps/control/.next/standalone -type f -name '*.map' -delete

FROM node:26.12.1-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe AS runtime
# The pinned base image can lag Debian security fixes, so install them at build time.
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*

ARG SERVICE_VERSION=development
ENV NODE_ENV=production
ENV PORT=3000
# Cloudflare's tunnel reaches the panel over Railway's private network, which
# is IPv6, so it listens on every address, IPv4 and IPv6.
ENV HOSTNAME=::
ENV SERVICE_VERSION=$SERVICE_VERSION
LABEL org.opencontainers.image.revision=$SERVICE_VERSION
WORKDIR /app

RUN groupadd --system --gid 1001 lobbystack && \
    useradd --system --uid 1001 --gid lobbystack lobbystack && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build --chown=lobbystack:lobbystack /app/apps/control/.next/standalone ./
COPY --from=build --chown=lobbystack:lobbystack /prod/control-static ./apps/control/.next/static

USER lobbystack
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=4 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/control/server.js"]
