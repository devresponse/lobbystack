{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "appName": {
      "type": "string"
    },
    "logo": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*\\.(?:svg|png|jpg|jpeg|webp)$"
    },
    "emailLogo": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*\\.png$"
    },
    "ogImage": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*\\.png$"
    },
    "accentColor": {
      "type": "string"
    },
    "links": {
      "type": "object",
      "properties": {
        "site": {
          "type": "string"
        },
        "terms": {
          "type": "string"
        },
        "privacy": {
          "type": "string"
        },
        "docs": {
          "type": "string"
        },
        "zapier": {
          "type": "string"
        },
        "make": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contactEmail": {
      "type": "string"
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\*?$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "appNameSuffix": {
            "type": "string"
          },
          "indexing": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "signInPage": {
      "type": "object",
      "properties": {
        "panel": {
          "type": "string",
          "enum": [
            "accent",
            "dark"
          ],
          "description": "accent (the default) fills the panel with the accent colour; dark makes it near-black with touches of the accent."
        },
        "headline": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "fr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "es": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "sr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "required": [
            "en",
            "fr",
            "es",
            "sr"
          ],
          "additionalProperties": false,
          "description": "Words in every interface language: en, fr, es and sr, each at most 80 characters."
        },
        "description": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "fr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "es": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sr": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "en",
            "fr",
            "es",
            "sr"
          ],
          "additionalProperties": false,
          "description": "The sentence under the headline, in every interface language."
        },
        "points": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "fr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "es": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "sr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "en",
              "fr",
              "es",
              "sr"
            ],
            "additionalProperties": false,
            "description": "Words in every interface language: en, fr, es and sr, each at most 80 characters."
          },
          "description": "Three short points, side by side under the example call."
        },
        "exampleCall": {
          "type": "object",
          "properties": {
            "lines": {
              "minItems": 2,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "fr": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "es": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "sr": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "en",
                  "fr",
                  "es",
                  "sr"
                ],
                "additionalProperties": false,
                "description": "Words in every interface language: en, fr, es and sr, each at most 120 characters."
              },
              "description": "Two to four lines: the caller's first, then taking turns with the receptionist."
            },
            "booked": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "fr": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "es": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "sr": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": [
                "en",
                "fr",
                "es",
                "sr"
              ],
              "additionalProperties": false,
              "description": "The line under the call, such as \"Appointment booked\"."
            }
          },
          "required": [
            "lines"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "The panel beside the sign-in and sign-up forms. The pages show the shared words for any part left out."
    }
  },
  "required": [
    "appName"
  ],
  "additionalProperties": false
}
