{
  "name": "lobbystack-pdf-parsing",
  "version": "0.1.0",
  "description": "Test tool that reads a folder of PDFs with today's worker reader or pdfjs-dist, scores the text and uploads it to a test business.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "pdf-parsing": "node src/cli.ts",
    "check-copy": "node src/cli.ts check-copy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
