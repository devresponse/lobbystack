{
  "url": "/appointments",
  "method": "GET",
  "qs": {
    "status": "confirmed",
    "starts_after": "{{formatDate(now, 'YYYY-MM-DDTHH:mm:ss[Z]', 'UTC')}}",
    "limit": 100
  },
  "response": {
    "limit": 300,
    "iterate": "{{body.data}}",
    "output": {
      "label": "{{formatDate(item.starts_at, 'YYYY-MM-DD HH:mm', item.timezone) + ' ' + item.service_name + ', ' + ifempty(item.contact_name, ifempty(item.contact_phone, 'no name'))}}",
      "value": "{{item.id}}"
    }
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.next_cursor}}"
    },
    "condition": "{{body.has_more}}"
  }
}
