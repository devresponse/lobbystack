{
  "url": "/contacts",
  "method": "GET",
  "qs": {
    "limit": 100
  },
  "response": {
    "limit": 300,
    "iterate": "{{body.data}}",
    "output": {
      "label": "{{ifempty(item.name, 'No name') + ' (' + ifempty(item.phone, ifempty(item.email, 'no phone')) + ')'}}",
      "value": "{{item.id}}"
    }
  },
  "pagination": {
    "qs": {
      "cursor": "{{body.next_cursor}}"
    },
    "condition": "{{body.has_more}}"
  }
}
