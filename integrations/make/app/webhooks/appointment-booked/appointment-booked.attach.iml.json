{
  "url": "/webhooks",
  "method": "POST",
  "body": {
    "url": "{{webhook.url}}",
    "events": [
      "appointment.booked"
    ],
    "description": "Make: Watch new appointments"
  },
  "response": {
    "data": {
      "externalHookId": "{{body.data.id}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization",
      "response.body.data.secret"
    ]
  }
}
