exports[`pnpm billing's output > plans alloplace on an empty organization 1`] = `
{
  "code": 0,
  "err": "",
  "out": {
    "brand": "alloplace",
    "catalog": [],
    "hash": "eaa1ff9d23698c357492756a9b93aa06953dd71cc664e4afb32175664e36e01b",
    "instance": "https://demo.alloplace.com",
    "links": {
      "plans": 2,
      "prices": 4,
    },
    "polar": {
      "env": "sandbox",
      "organization": "org_test",
    },
    "refusals": [],
    "steps": [
      {
        "action": "update",
        "changes": [
          "allow one subscription per customer",
          "turn on plan changes in the customer portal",
        ],
        "object": "organization",
        "subject": "Test organization",
      },
      {
        "action": "create",
        "changes": [
          "Sum of quantity where Name equals billing.voice_minutes",
        ],
        "object": "meter",
        "subject": "Meter "Voice minutes"",
      },
      {
        "action": "create",
        "changes": [
          "Sum of quantity where Name equals billing.alert_sms_segments",
        ],
        "object": "meter",
        "subject": "Meter "Alert SMS segments"",
      },
      {
        "action": "create",
        "changes": [
          "Sum of quantity where Name equals billing.outbound_call_attempts",
        ],
        "object": "meter",
        "subject": "Meter "Call transfers"",
      },
      {
        "action": "create",
        "changes": [
          "370.00 CAD a year, Voice minutes at 0.20 CAD each, Alert SMS segments at 0.02 CAD each, Call transfers at 0.02 CAD each",
          "overage invoiced each month",
        ],
        "object": "product",
        "subject": "Product "Starter annual"",
      },
      {
        "action": "create",
        "changes": [
          "37.00 CAD a month, Voice minutes at 0.20 CAD each, Alert SMS segments at 0.02 CAD each, Call transfers at 0.02 CAD each",
        ],
        "object": "product",
        "subject": "Product "Starter monthly"",
      },
      {
        "action": "create",
        "changes": [
          "870.00 CAD a year, Voice minutes at 0.18 CAD each, Alert SMS segments at 0.02 CAD each, Call transfers at 0.02 CAD each",
          "overage invoiced each month",
        ],
        "object": "product",
        "subject": "Product "Pro annual"",
      },
      {
        "action": "create",
        "changes": [
          "87.00 CAD a month, Voice minutes at 0.18 CAD each, Alert SMS segments at 0.02 CAD each, Call transfers at 0.02 CAD each",
        ],
        "object": "product",
        "subject": "Product "Pro monthly"",
      },
      {
        "action": "create",
        "changes": [
          "Raw, 15 events, API version 2026-10",
        ],
        "object": "webhook",
        "subject": "Webhook https://demo.alloplace.com/api/webhooks/polar",
      },
    ],
  },
}
`;

